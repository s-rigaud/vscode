{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "dictionaryDefinitions": [
        {
            "name": "project-words",
            "path": "./project-words.txt",
            "addWords": true
        }
    ],
    "dictionaries": [
        "project-words"
    ],
    "ignorePaths": [
        "**/lorem.txt",
        "**tmLanguage.json",
        "ThirdPartyNotices.txt",
        "build/win32/i18n/Default.hu.isl",
        "extensions/git/resources/emojis.json",
        "extensions/php-language-features/src/features/phpGlobalFunctions.ts",
        "extensions/terminal-suggest/src/shell/zshBuiltinsCache.ts",
        "src/vs/base/test/common/filters.perf.data.js",
        "src/vs/base/test/node/uri.perf.data.txt",
        "src/vs/workbench/contrib/tags/electron-sandbox/workspaceTagsService.ts",
        "src/vs/workbench/services/textfile/test/common/fixtures/files.ts",
        /**/
        "cspell.json",
        "spelling-errors-og.txt",
        "spelling-errors.txt",
        "project-words-og.txt",
        "project-words.txt",
        "files_most_errors.txt",
        "utils.py"
    ]
}

// Listing files
// cspell "**" --no-issues

// Saving errors
// cspell "**" > "spelling-errors.txt"

// Ensuring no issues are found
// cspell --words-only --unique "**" >> project-words.txt
